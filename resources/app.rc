#include <winver.h>
#include "resource.h"

IDI_APP_ICON ICON "icon.ico"

// Shown in Task Manager and the file's Properties window.
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1, 1, 0, 0
PRODUCTVERSION 1, 1, 0, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Folder Tracker"
            VALUE "ProductName", "Folder Tracker"
            VALUE "FileVersion", "1.1.0"
            VALUE "ProductVersion", "1.1.0"
            VALUE "OriginalFilename", "Folder Tracker.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
